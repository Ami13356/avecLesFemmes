{% extends 'base.html.twig' %}

{% block title %}Groupements — Avec les Femmes{% endblock %}

{% block body %}
    <h1>Groupements</h1>
    <p class="fil-ariane">{{ pagination.total }} groupement(s) trouvé(s)</p>
    <p><a class="bouton" href="{{ path('groupement_new') }}">+ Ajouter un groupement</a></p>

    {{ form_start(form) }}
        <div class="filtre">
            {{ form_row(form.telephone) }}
            {{ form_row(form.ville) }}
            {{ form_row(form.filtrer) }}
            <a class="bouton secondaire" href="{{ path('groupement_index') }}">Réinitialiser</a>
        </div>
    {{ form_end(form) }}

    {% if pagination.items is empty %}
        <p class="vide">Aucun groupement ne correspond à votre recherche.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Téléphone</th>
                    <th>Ville</th>
                    <th>Adresse</th>
                    <th>Exercice en cours</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for groupement in pagination.items %}
                    <tr>
                        <td><strong>{{ groupement.nom }}</strong></td>
                        <td>{{ groupement.telephone }}</td>
                        <td>{{ groupement.ville }}</td>
                        <td>{{ groupement.adresse }}</td>
                        <td>
                            {% if groupement.aUnExerciceEnCours %}
                                {{ groupement.exerciceDateDebut }} → {{ groupement.exerciceDateFin }}
                                <span class="badge ok">{{ groupement.exerciceStatut }}</span>
                            {% else %}
                                <span class="badge alerte">{{ groupement.exerciceStatut }}</span>
                            {% endif %}
                        </td>
                        <td><a class="bouton" href="{{ path('groupement_campagnes', {id: groupement.id}) }}">Campagnes</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if pagination.nbPages > 1 %}
            <nav class="pagination">
                {% if pagination.aPagePrecedente %}
                    <a href="{{ path('groupement_index', app.request.query.all|merge({page: pagination.page - 1})) }}">‹ Précédent</a>
                {% endif %}

                {% for numero in 1..pagination.nbPages %}
                    {% if numero == pagination.page %}
                        <strong>{{ numero }}</strong>
                    {% else %}
                        <a href="{{ path('groupement_index', app.request.query.all|merge({page: numero})) }}">{{ numero }}</a>
                    {% endif %}
                {% endfor %}

                {% if pagination.aPageSuivante %}
                    <a href="{{ path('groupement_index', app.request.query.all|merge({page: pagination.page + 1})) }}">Suivant ›</a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}