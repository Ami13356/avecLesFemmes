{% extends 'base.html.twig' %}

{% block title %}Ajouter un groupement — Avec les Femmes{% endblock %}

{% block body %}
    <h1>Ajouter un groupement</h1>
    <p class="fil-ariane"><a href="{{ path('groupement_index') }}">Groupements</a> › Nouveau</p>

    <div class="carte formulaire">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.telephone) }}
            {{ form_row(form.ville) }}
            {{ form_row(form.adresse) }}
            {{ form_row(form.enregistrer) }}
        {{ form_end(form) }}
    </div>
{% endblock %}