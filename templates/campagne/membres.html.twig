{% extends 'base.html.twig' %}

{% block title %}Membres — {{ campagne.nom }}{% endblock %}

{% block body %}
    <h1>Membres de la campagne « {{ campagne.nom }} »</h1>
    <p class="fil-ariane">
        <a href="{{ path('groupement_index') }}">Groupements</a> ›
        <a href="{{ path('groupement_campagnes', {id: campagne.groupementId}) }}">{{ campagne.groupementNom }}</a> ›
        {{ campagne.nom }} ({{ campagne.type }})
    </p>

    {% if membres is empty %}
        <p class="vide">Aucun membre inscrit à cette campagne.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom complet</th>
                    <th>Téléphone</th>
                    <th>Adresse</th>
                    <th>Rôle</th>
                    <th>Mode de cotisation</th>
                </tr>
            </thead>
            <tbody>
                {% for membre in membres %}
                    <tr>
                        <td><strong>{{ membre.nomComplet }}</strong></td>
                        <td>{{ membre.telephone }}</td>
                        <td>{{ membre.adresse }}</td>
                        <td>{{ membre.role }}</td>
                        <td><span class="badge">{{ membre.modeCotisation }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if campagne.aDesSeances %}
        <p><a class="bouton" href="{{ path('campagne_seances', {id: campagne.id}) }}">Voir les séances</a></p>
    {% endif %}
{% endblock %}